#!/bin/sh
# Maintainer preview. Published-site organizers just open the website.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if ! command -v hugo >/dev/null 2>&1; then
  echo 'The local preview needs Hugo. The published site only needs a browser.' >&2
  exit 1
fi
exec hugo server --source site --bind 127.0.0.1 --port 1313 --disableLiveReload --noHTTPCache --cacheDir "$PWD/site/.cache" "$@"
