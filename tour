#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ ! -x .venv/bin/python ]; then
  echo 'Install dependencies first: uv venv --python 3.13 && uv pip sync requirements.txt' >&2
  exit 1
fi
mode="${1:-demo}"
case "$mode" in
  demo)
    export DEBUG=1 DEMO_MODE=1
    export TOURNEY_DATA_DIR="$PWD/.data/demo"
    export EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
    ;;
  serve)
    export DEMO_MODE=0
    ;;
  *) echo 'Usage: ./tour [demo|serve]' >&2; exit 1 ;;
esac
.venv/bin/python manage.py migrate --noinput
if [ "$mode" = demo ]; then .venv/bin/python manage.py seed_demo; fi
.venv/bin/python manage.py check
.venv/bin/python manage.py work_outbox &
tourney_worker_pid=$!
trap 'kill "$tourney_worker_pid" 2>/dev/null || true' EXIT HUP INT TERM
echo 'Open http://127.0.0.1:8000/ · Press Ctrl-C to stop the server and worker.'
.venv/bin/python manage.py runserver 127.0.0.1:8000 --noreload
